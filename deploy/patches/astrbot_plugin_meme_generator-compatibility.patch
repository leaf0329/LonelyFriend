+    def _local_resources_complete(self) -> bool:
+        # The default CDN is unreachable on this host; validated offline assets
+        # should not wait for a network scan on every bot restart.
+        if self.data_dir is None:
+            return False
+        root = self.data_dir / "resources"
+        manifest_path = root / "resources.json"
+        if not manifest_path.is_file():
+            return False
+        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+        if manifest.get("version") != version("meme_generator"):
+            return False
+        for kind in ("fonts", "images"):
+            for entry in manifest[kind]:
+                target = (root / kind / entry["file"]).resolve()
+                if not target.is_relative_to(root.resolve()):
+                    raise ValueError("Invalid meme resource path")
+                if not target.is_file() or hashlib.sha256(target.read_bytes()).hexdigest() != entry["hash"]:
+                    return False
+        return True
